# Copie para .env e preencha. NUNCA versione o .env (ele está no .gitignore).
# cp .env.example .env
# Os IDs e chaves em branco abaixo são preenchidos pelo setup.sh conforme cria os recursos.

# --- Confluent Cloud ---
CONFLUENT_ENV_NAME=desafio-final
CONFLUENT_CLUSTER_NAME=desafio-basic
CONFLUENT_CLOUD=aws
CONFLUENT_REGION=us-east-1

# Service accounts (menor privilégio: uma escreve, outra lê)
SA_PRODUCER_NAME=desafio-producer
SA_CONSUMER_NAME=desafio-consumer

# Preenchidos após a criação (IDs e chaves gerados pelo setup)
CONFLUENT_ENV_ID=
CONFLUENT_CLUSTER_ID=
SA_PRODUCER_ID=
SA_CONSUMER_ID=
KAFKA_API_KEY=
KAFKA_API_SECRET=
SCHEMA_REGISTRY_URL=
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# Tableflow (REST catalog Iceberg). Chave criada com: confluent api-key create --resource tableflow
TABLEFLOW_ENDPOINT=
TABLEFLOW_API_KEY=
TABLEFLOW_API_SECRET=

# --- Postgres (Neon) ---
# PG_HOST: o host do Neon (ex.: ep-xxxx-pooler.<regiao>.aws.neon.tech).
# PG_ADMIN_USER: o NOME do usuário do Postgres (ex.: o owner do Neon ou cdc_user), NÃO o hostname.
# Preencher com o hostname gera "password authentication failed for user '<hostname>'".
PG_HOST=
PG_PORT=5432
PG_DB=
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=

# Usuário dedicado ao CDC, com permissão mínima de replicação. Crie-o COM o atributo REPLICATION
# pelo painel de Roles do Neon (role criado só por SQL pode não receber esse atributo).
CDC_USER=cdc_user
CDC_PASSWORD=

# --- Parâmetros do pipeline ---
TOPIC_PREFIX=desafio
SEED=42
